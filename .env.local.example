# Supabase configuration (copy to .env.local and fill values)
# Do NOT commit your .env.local (contains secrets)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# After filling, restart Next dev server: npm run dev
# To get these values: Settings -> API in the Supabase project dashboard

# Server-side service role key (KEEP SECRET, do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret used to sign application JWTs returned by the create-user endpoint
JWT_SECRET=your-jwt-secret
